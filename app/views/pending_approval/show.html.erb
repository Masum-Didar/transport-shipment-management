<% content_for :title, "Pending Approval" %>

<div class="max-w-md text-center">
  <div class="w-16 h-16 bg-amber-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
    <span class="text-3xl">⏳</span>
  </div>
  <h1 class="text-xl font-bold text-gray-900">Account Pending Approval</h1>
  <p class="text-sm text-gray-500 mt-2">
    Your account is currently under review. An admin will activate your account shortly.
    You will be able to access the system once your account is approved.
  </p>
  <div class="mt-6 inline-flex items-center gap-2 text-xs text-gray-500">
    <span class="inline-block w-2 h-2 rounded-full bg-amber-400"></span>
    Status: <%= status_badge("onboarding") %>
  </div>
</div>
