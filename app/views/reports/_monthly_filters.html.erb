<div data-filter-group="monthly">
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-7 gap-3 items-end">
    <div>
      <%= label_tag :date, "Month", class: "block text-xs font-medium text-gray-600 mb-1" %>
      <%= month_field_tag :date, @date, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none transition" %>
    </div>
    <%= render partial: "common_filters" %>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1 invisible">Submit</label>
      <%= submit_tag "Generate", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition cursor-pointer" %>
    </div>
  </div>
</div>
