<% content_for :page_title, "Users" %>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold text-gray-900">Users</h1>
    <span class="text-sm text-gray-500"><%= @users.count %> account<%= @users.count == 1 ? "" : "s" %></span>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
    <%= form_tag users_path, method: :get, class: "flex flex-wrap items-center gap-3" do %>
      <div class="relative flex-1 min-w-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <%= text_field_tag :q, params[:q], placeholder: "Search name or email...", class: "w-full pl-9 pr-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" %>
      </div>
      <%= select_tag :status, options_for_select([["All Status", ""], "Onboarding", "Active", "Inactive"], params[:status]), class: "px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" %>
      <%= submit_tag "Filter", class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors" %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200">
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Joined</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @users.empty? %>
            <tr>
              <td colspan="6">
                <%= render EmptyStateComponent.new(icon: "👤", title: "No accounts found", description: "Pending signups will appear here", action: nil) %>
              </td>
            </tr>
          <% else %>
            <% @users.each do |user| %>
              <tr class="hover:bg-blue-50/30 transition-colors">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-slate-200 rounded-full flex items-center justify-center text-sm font-semibold text-slate-600">
                      <%= user.name.split.map { |n| n[0] }.join[0..1].upcase %>
                    </div>
                    <span class="text-sm font-medium text-gray-800"><%= user.name %></span>
                  </div>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-gray-600"><%= user.email %></td>
                <td class="px-4 py-3">
                  <span class="text-xs font-medium px-2 py-0.5 rounded <%= user.super_admin? ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700" %>">
                    <%= user.role.name.titleize %>
                  </span>
                </td>
                <td class="px-4 py-3"><%= status_badge(user.status) %></td>
                <td class="px-4 py-3 text-xs text-gray-500"><%= l(user.created_at, format: :short) %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2 justify-end">
                    <% if policy(user).activate? && user.status != "active" %>
                      <%= button_to activate_user_path(user), method: :patch, class: "inline-flex items-center gap-1 text-xs font-medium bg-green-600 text-white px-3 py-1.5 rounded-lg hover:bg-green-700 transition-colors" do %>
                        <%= check_icon %> Activate
                      <% end %>
                    <% elsif policy(user).deactivate? && user.status == "active" %>
                      <%= button_to deactivate_user_path(user), method: :patch, class: "inline-flex items-center gap-1 text-xs font-medium bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg hover:bg-gray-300 transition-colors" do %>
                        Deactivate
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
